# Required only for `python -m wallonia_scraper.push_to_supabase` (also
# called automatically at the end of `weekly.py`). Without these set, the
# scrapers still run and write local JSONL as normal — the push step logs a
# warning and is skipped rather than failing the run.
#
# Use the SAME values as the real TenderProc product's .env.local:
#   SUPABASE_URL                = product's NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY   = product's SUPABASE_SERVICE_ROLE_KEY
# (different variable names between the two repos, same Supabase project.)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
